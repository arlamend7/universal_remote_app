    "version": "0.2.0",
    "configurations": [
        {
            "name": "Universal Control",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=.env"]

        },
        {
            "name": "universal_remote_app",
            "cwd": "apps/universal_remote_app",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=.env"]
        },
        {
            "name": "universal_remote_app (profile mode)",
            "cwd": "apps/universal_remote_app",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=.env"],
            "flutterMode": "profile"
        },
        {
            "name": "universal_remote_app (release mode)",
            "cwd": "apps/universal_remote_app",
            "request": "launch",
            "type": "dart",
            "args": ["--dart-define-from-file=.env"],
            "flutterMode": "release"
        },
        {
            "name": "remote_core",
            "cwd": "packages/remote_core",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "remote_driver_runtime",
            "cwd": "packages/remote_driver_runtime",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "remote_network",
            "cwd": "packages/remote_network",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "remote_ui",
            "cwd": "packages/remote_ui",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "remote_ui (profile mode)",
            "cwd": "packages/remote_ui",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "remote_ui (release mode)",
            "cwd": "packages/remote_ui",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
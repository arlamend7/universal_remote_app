# Copy to .env (git-ignored) and fill in. Flutter reads it with
#   flutter run --dart-define-from-file=.env
# The VS Code launch configurations pass it automatically.

# GitHub Pages base URL of the signed driver catalog (must end with /).
DRIVER_CATALOG_BASE_URL=https://arlamend7.github.io/universal_remote_app/

# Trusted catalog signing keys: JSON map of key ID to the Base64 uncompressed
# P-256 public point (65 bytes, first byte 0x04). Public values only; the
# private signing key never belongs here.
DRIVER_TRUSTED_KEYS='{"universal-remote-1":"<base64 public point>"}'

# Development builds only (ignored in release mode):
# ALLOW_DEVELOPMENT_INTEGRATIONS=true
# DRIVER_LOCAL_PATH=/absolute/path/to/drivers/providers

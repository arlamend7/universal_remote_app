{
  "volume": {
    "alternatives": [
      [
        "volume-up",
        "volume-down"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "CONTROL_AUDIO"
    ]
  },
  "volumeFeedback": {
    "alternatives": [
      [
        "read-volume"
      ]
    ],
    "verify": {
      "operation": "read-volume",
      "availability": "verified"
    },
    "permissions": [
      "CONTROL_AUDIO"
    ]
  },
  "absoluteVolume": {
    "alternatives": [
      [
        "set-volume"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ]
  },
  "mute": {
    "alternatives": [
      [
        "set-mute",
        "read-volume"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ]
  },
  "applications": {
    "alternatives": [
      [
        "list-applications",
        "launch-application"
      ]
    ],
    "verify": {
      "operation": "list-applications",
      "expect": "non-empty",
      "availability": "known"
    },
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "READ_INSTALLED_APPS",
      "LAUNCH"
    ]
  },
  "accessorySettings": {
    "alternatives": [
      [
        "open-accessory-settings"
      ]
    ],
    "when": [
      {
        "fact": "application.com.palm.app.settings",
        "equals": "present",
        "missing": false
      }
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ]
  },
  "inputs": {
    "alternatives": [
      [
        "list-inputs",
        "select-input"
      ]
    ],
    "verify": {
      "operation": "list-inputs",
      "expect": "non-empty",
      "availability": "known"
    },
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "READ_INPUT_DEVICE_LIST",
      "CONTROL_INPUT_TV"
    ]
  },
  "navigation": {
    "alternatives": [
      [
        "navigation-up",
        "navigation-down",
        "navigation-left",
        "navigation-right",
        "navigation-enter",
        "navigation-back",
        "navigation-home"
      ]
    ],
    "verify": {
      "operation": "open-pointer",
      "availability": "known"
    },
    "permissions": [
      "CONTROL_MOUSE_AND_KEYBOARD"
    ]
  },
  "pointer": {
    "alternatives": [
      [
        "pointer-move",
        "pointer-scroll",
        "pointer-click"
      ]
    ],
    "when": [
      {
        "fact": "pointer.open",
        "equals": "true",
        "missing": false
      }
    ]
  },
  "bluetoothAccessories": {
    "alternatives": [
      [
        "list-accessories",
        "toggle-accessory"
      ]
    ],
    "verify": {
      "operation": "list-accessories",
      "timeoutMs": 2000,
      "availability": "known"
    },
    "disableOn": [
      "unsupported",
      "permission"
    ]
  },
  "screenPower": {
    "alternatives": [
      [
        "screen-off",
        "screen-on"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "reason": "Screen power is not verified on hardware."
  },
  "currentContent": {
    "alternatives": [
      [
        "read-content"
      ]
    ]
  },
  "currentInput": {
    "alternatives": [
      [
        "read-content"
      ]
    ]
  },
  "channels": {
    "alternatives": [
      [
        "channel-up",
        "channel-down"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ]
  },
  "media": {
    "alternatives": [
      [
        "media-play",
        "media-pause",
        "media-stop"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "CONTROL_INPUT_MEDIA_PLAYBACK"
    ]
  },
  "textInput": {
    "alternatives": [
      [
        "send-text",
        "send-enter"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "CONTROL_INPUT_TEXT"
    ]
  },
  "channelSelection": {
    "alternatives": [
      [
        "list-channels",
        "select-channel"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "READ_TV_CHANNEL_LIST"
    ]
  },
  "power": {
    "alternatives": [
      [
        "power-off"
      ]
    ],
    "disableOn": [
      "unsupported",
      "permission"
    ],
    "permissions": [
      "CONTROL_POWER"
    ]
  }
}

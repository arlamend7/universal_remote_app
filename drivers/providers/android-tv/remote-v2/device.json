{
  "setup": {
    "label": "Google TV / Android TV",
    "address": "numeric",
    "endpoint": {"scheme": "tls", "port": 6466},
    "defaultName": "Android TV",
    "category": "television",
    "messages": {
      "secureOnly": "Android TV requires a secure connection.",
      "address": "Enter the TV’s local IP address."
    }
  },
  "policy": {
    "sameConnection": ["macAddress", "broadcastAddress", "verifiedPeerIdentity"],
    "retryAfterWake": ["network", "networkAccess", "connectionRefused", "timeout"],
    "mergeDiscovered": "replace-host"
  },
  "wake": {
    "kind": "engine",
    "mapping": {
      "kind": "remote-v2.wake",
      "code": 224,
      "portMetadata": "remoteWakePort",
      "fallbackPorts": {"Smart TV Pro": 6465}
    },
    "fallback": "wake-on-lan",
    "message": "Connect to the TV once while it is on to set up network wake."
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalog.schema.json",
  "title": "Signed integration catalog payload (v2/catalog.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "revision", "publishedAt", "integrations"],
  "properties": {
    "schemaVersion": {"const": 2},
    "revision": {"type": "integer", "minimum": 1},
    "publishedAt": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "integrations": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/integration"}}
  },
  "$defs": {
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "payload", "signature"],
      "properties": {
        "keyId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]{0,63}$"},
        "payload": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 4, "maxLength": 512, "pattern": "^[A-Za-z0-9+/]+={0,2}$"}
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "providerId", "name", "manufacturer", "platform", "engine", "channel", "lastUpdatedAt", "requiredRuntime", "compatibility", "profiles", "capabilities", "package", "sha256", "size", "signature"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/identifier"},
        "providerId": {"$ref": "common.schema.json#/$defs/identifier"},
        "name": {"$ref": "common.schema.json#/$defs/label"},
        "manufacturer": {"$ref": "common.schema.json#/$defs/label"},
        "platform": {"$ref": "common.schema.json#/$defs/label"},
        "engine": {"$ref": "common.schema.json#/$defs/identifier"},
        "channel": {"enum": ["stable", "development"]},
        "lastUpdatedAt": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
        "requiredRuntime": {"$ref": "common.schema.json#/$defs/requiredRuntime"},
        "compatibility": {"$ref": "common.schema.json#/$defs/compatibility"},
        "profiles": {"type": "array", "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/profile"}},
        "capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/capability"}},
        "conditionalCapabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/capability"}},
        "discovery": {"type": "object"},
        "device": {"type": "object"},
        "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
        "package": {"type": "string", "pattern": "^packages/objects/[0-9a-f]{64}/driver\\.zip$"},
        "sha256": {"$ref": "common.schema.json#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 1, "maximum": 4194304},
        "signature": {"type": "string", "minLength": 4, "maxLength": 512, "pattern": "^[A-Za-z0-9+/]+={0,2}$"},
        "replaces": {"type": "array", "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/identifier"}}
      }
    }
  }
}

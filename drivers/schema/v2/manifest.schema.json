{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Integration manifest (packaged manifest.json)",
  "description": "Stable integration identity. There is no package version: the publisher stamps lastUpdatedAt and the catalog carries the content SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "integrationId", "providerId", "name", "manufacturer", "platform", "engine", "requiredRuntime", "compatibility", "profiles", "capabilities"],
  "properties": {
    "schemaVersion": {"const": 2},
    "integrationId": {"$ref": "common.schema.json#/$defs/identifier"},
    "providerId": {"$ref": "common.schema.json#/$defs/identifier"},
    "name": {"$ref": "common.schema.json#/$defs/label"},
    "manufacturer": {"$ref": "common.schema.json#/$defs/label"},
    "platform": {"$ref": "common.schema.json#/$defs/label"},
    "engine": {"$ref": "common.schema.json#/$defs/identifier"},
    "lastUpdatedAt": {"$ref": "common.schema.json#/$defs/utcTimestamp"},
    "requiredRuntime": {"$ref": "common.schema.json#/$defs/requiredRuntime"},
    "credentialScope": {"enum": ["device", "integration"]},
    "compatibility": {"$ref": "common.schema.json#/$defs/compatibility"},
    "profiles": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "common.schema.json#/$defs/profile"}},
    "capabilities": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/capability"}},
    "priority": {"type": "integer", "minimum": 0, "maximum": 1000},
    "replaces": {"type": "array", "maxItems": 32, "items": {"$ref": "common.schema.json#/$defs/identifier"}}
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driver capability",
  "type": "object",
  "propertyNames": {
    "enum": [
      "volume",
      "volumeFeedback",
      "mute",
      "navigation",
      "power",
      "applications",
      "inputs",
      "media",
      "channels",
      "currentContent",
      "pointer",
      "textInput",
      "channelSelection",
      "climate",
      "lighting",
      "wake",
      "voice",
      "gameMode",
      "watch",
      "currentInput",
      "trackNavigation",
      "seek",
      "playbackMetadata",
      "absoluteVolume",
      "accessorySettings",
      "bluetoothAccessories",
      "playbackToggle",
      "numericKeys",
      "specialKeys",
      "tvSettings",
      "playbackScan",
      "liveTvKey",
      "screenPower",
      "captionsKey",
      "instantReplay",
      "channelCatalog"
    ]
  },
  "additionalProperties": {
    "type": "array",
    "items": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_-]{0,63}$"
    },
    "minItems": 1,
    "maxItems": 16,
    "uniqueItems": true
  }
}

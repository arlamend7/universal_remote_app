{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driver catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "publishedAt",
    "releases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "package",
          "size",
          "sha256",
          "signature",
          "channel"
        ],
        "properties": {
          "manifest": {
            "$ref": "manifest.schema.json"
          },
          "package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^packages/[a-z][a-z0-9._-]*/[0-9.]+/driver\\.zip$"
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4194304
          },
          "sha256": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-f0-9]{64}$"
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "channel": {
            "enum": [
              "stable",
              "development"
            ]
          },
          "discovery": {
            "$ref": "discovery.schema.json"
          },
          "publishedAt": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "maxLength": 4096
          }
        }
      },
      "minItems": 0,
      "maxItems": 1024
    }
  }
}

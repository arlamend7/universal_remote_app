{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driver discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "targets",
    "port",
    "path"
  ],
  "properties": {
    "targets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "ssdp": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_:.+/-]{1,128}$"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "bonjour": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_:.+/-]{1,128}$"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "unicast": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-zA-Z0-9_:.+/-]{1,128}$"
          },
          "minItems": 1,
          "maxItems": 16
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^/[a-zA-Z0-9_./-]{0,127}$"
    }
  }
}

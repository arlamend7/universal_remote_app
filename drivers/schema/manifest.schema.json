{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Driver manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "providerId",
    "version",
    "name",
    "manufacturer",
    "platform",
    "requiredRuntime",
    "operations",
    "capabilities",
    "compatibility"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "providerId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9._-]{0,79}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "manufacturer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "requiredRuntime": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^>=(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})( <(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8})\\.(0|[1-9][0-9]{0,8}))?$"
    },
    "operations": {
      "type": "array",
      "items": {
        "enum": [
          "websocket.connect",
          "websocket.sendJson",
          "websocket.awaitJson",
          "websocket.disconnect",
          "websocket.request",
          "websocket.subscribe",
          "websocket.unsubscribe",
          "websocket.authenticate",
          "websocket.pair",
          "Unknown required driver operation."
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "capabilities": {
      "type": "array",
      "items": {
        "enum": [
          "volume",
          "volumeFeedback",
          "mute",
          "navigation",
          "power",
          "applications",
          "inputs",
          "media",
          "channels",
          "currentContent",
          "pointer",
          "textInput",
          "channelSelection",
          "climate",
          "lighting",
          "wake",
          "voice",
          "gameMode",
          "watch",
          "currentInput",
          "trackNavigation",
          "seek",
          "playbackMetadata",
          "absoluteVolume",
          "accessorySettings",
          "bluetoothAccessories",
          "playbackToggle",
          "numericKeys",
          "specialKeys",
          "tvSettings",
          "playbackScan",
          "liveTvKey",
          "screenPower",
          "captionsKey",
          "instantReplay",
          "channelCatalog"
        ]
      },
      "minItems": 0,
      "maxItems": 256
    },
    "compatibility": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "models"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_-]{0,79}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 999999999
          },
          "models": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "minItems": 0,
            "maxItems": 256
          },
          "osVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "firmwareVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "minItems": 1,
      "maxItems": 256
    }
  }
}
